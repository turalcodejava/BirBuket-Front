# BirBuket Full-Stack Configuration
# Internal AI Studio Port (must be 3000)
PORT=3000

# Real Backend URL (Java/Spring Boot)
BACKEND_URL=http://localhost:8081

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=birbuketdb
DB_USER=birbuket
DB_PASSWORD=

# Auth Database
AUTH_DB_URL=postgresql://birbuket:YOUR_DB_PASSWORD@localhost:5432/auth_db

# JWT Configuration
JWT_SECRET=birbuket_secret_key_123

# Frontend specific (Vite)
VITE_API_BASE_URL=
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
# Optional: comma separated image models to try in order
VITE_GEMINI_IMAGE_MODELS=gemini-2.5-flash-image,gemini-2.0-flash-preview-image-generation
